<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 字幕摘录" Width="410" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#26364F" ShowInTaskbar="False">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="窗口不透明度" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="OpacityValue" Text="100%" HorizontalAlignment="Right" Foreground="#2868E5" FontWeight="SemiBold"/></Grid>
        <StackPanel Grid.Row="1" Margin="0,13,0,0">
            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" SmallChange="5" LargeChange="10" AutomationProperties.Name="窗口不透明度"/>
            <TextBlock Text="数值越低越透明，最低为 30%。" FontSize="12" Foreground="#718096" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,23,0,0">
            <CheckBox x:Name="ProtectTextToggle" Content="保护文字清晰度" FontWeight="SemiBold"/>
            <TextBlock Text="开启后仅淡化背景，文字和图标保持清晰。&#10;关闭后整个窗口一起变淡。" TextWrapping="Wrap" LineHeight="21" FontSize="12" Foreground="#718096" Margin="21,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="#DEE5EF" BorderThickness="0,1,0,0" Margin="0,20,0,10" Padding="0,12,0,0" VerticalAlignment="Bottom">
            <StackPanel><TextBlock Text="开发者" FontSize="11" Foreground="#718096"/><TextBlock Margin="0,5,0,0"><Hyperlink x:Name="DeveloperLink">gumo_anima（@zaunpowpow）</Hyperlink><Run Text="  ·  v1.2.0"/></TextBlock></StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ResetButton" Content="恢复默认" Padding="13,6" Margin="0,0,10,0"/><Button x:Name="DoneButton" Content="完成" Padding="18,6" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
