<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕摘录" Width="480" Height="640" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#202D41"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Focusable="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#34445B" />
            <Setter Property="BorderBrush" Value="#DEE5EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#699AF5" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.40" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E6EFFF" /><Setter TargetName="Frame" Property="BorderBrush" Value="#6599F8" /><Setter Property="Foreground" Value="#245EDB" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#699AF5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SentenceButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EDF3FF" /><Setter TargetName="Frame" Property="BorderBrush" Value="#AAC5FA" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#699AF5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#DFEAFF" /></Trigger>
                            <DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EDF8F2" /><Setter TargetName="Frame" Property="BorderBrush" Value="#B2DCC5" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E3E8F0" BorderThickness="0,0,0,1" Padding="22,20,22,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="BrandIcon" Width="32" Height="32" Margin="0,0,10,0" />
                        <TextBlock Text="字幕摘录" FontSize="23" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF4FC" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                        <TextBlock Text="本地运行" FontSize="11" Foreground="#6A7C98" />
                    </Border>
                </Grid>
                <Grid Margin="0,19,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="CopyAllButton" Content="复制全部" Style="{StaticResource ToolbarButton}" Background="#2868E5" Foreground="White" BorderBrush="#2868E5" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CopyAllButton" />
                    <Button x:Name="ClearButton" Grid.Column="1" Content="清空" Margin="9,0,0,0" Style="{StaticResource ToolbarButton}" AutomationProperties.AutomationId="ClearButton" />
                    <ToggleButton x:Name="PinToggle" Grid.Column="2" Content="置顶" Margin="9,0,0,0" Style="{StaticResource PinButton}" ToolTip="让窗口保持在其他窗口上方" AutomationProperties.AutomationId="PinToggle" />
                </Grid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20,17,14,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="2,0,8,11">
                <TextBlock Text="本次字幕" FontWeight="SemiBold" FontSize="12" Foreground="#566781" />
                <TextBlock x:Name="CountText" Text="0 段 · 点击复制" FontSize="11" Foreground="#74839A" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ListBox x:Name="SentenceList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     HorizontalContentAlignment="Stretch" IsTabStop="False" AutomationProperties.AutomationId="SentenceList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SentenceButton}" AutomationProperties.Name="{Binding Text}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="25">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#26364F" /><Style.Triggers><DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Foreground" Value="#67788F" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="已复制" Foreground="#278457" FontSize="11" Margin="0,5,0,0" Visibility="{Binding IsCopied, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,18,24" MaxWidth="320">
                <Border Width="54" Height="54" CornerRadius="15" Background="#E7EEFC" HorizontalAlignment="Center" Margin="0,0,0,17">
                    <Viewbox Width="26" Height="26"><Canvas Width="26" Height="26"><Path Stroke="#5683D9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,5 L 22,5 L 22,18 L 12,18 L 7,22 L 7,18 L 4,18 Z M 8,10 L 18,10 M 8,14 L 15,14" /></Canvas></Viewbox>
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="等待实时字幕" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="打开 Windows 实时字幕并播放声音，&#10;识别到的句子会出现在这里。" Foreground="#8692A5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,18" />
                <Button x:Name="LaunchButton" Content="打开实时字幕" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Center" AutomationProperties.AutomationId="LaunchButton" />
                <TextBlock x:Name="ShortcutHint" Text="系统快捷键  Win + Ctrl + L" FontSize="11" Foreground="#9AA5B5" HorizontalAlignment="Center" Margin="0,11,0,0" />
            </StackPanel>
            <Button x:Name="LatestButton" Grid.Row="1" Content="回到最新 ↓" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" Visibility="Collapsed" />
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#A6B1C2" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="等待实时字幕" FontSize="11" Foreground="#7B899E" TextTrimming="CharacterEllipsis" ToolTip="等待实时字幕" />
                </Grid>
                <Button x:Name="ReconnectButton" Grid.Column="1" Content="打开字幕" FontSize="11" Padding="7,3" Margin="7,0,0,0" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" ToolTip="重新打开 Windows 实时字幕（Win + Ctrl + L）" AutomationProperties.AutomationId="ReconnectButton" />
                <TextBlock x:Name="ToastText" Grid.Column="2" Text="退出后不保留记录" FontSize="11" Foreground="#9AA5B5" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
